{
  "name": "relaylab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "start": "node --import tsx src/api.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --import tsx integration/real-postgres.ts",
    "worker": "node --import tsx src/worker.ts",
    "receiver": "node --import tsx src/receiver-main.ts",
    "test:e2e": "node --import tsx integration/http-e2e.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
